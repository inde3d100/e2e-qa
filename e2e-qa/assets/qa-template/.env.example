# Copy this file to .env and fill it. Never commit .env.
# The address of the TEST copy of the app. Never the live app with real users.
QA_BASE_URL=http://127.0.0.1:3000
# Leave empty when the API has the same address as QA_BASE_URL.
QA_API_URL=
# Optional health address. The round stops when it does not answer. Default: QA_BASE_URL.
QA_HEALTH_URL=
# The app source folder. The report shows its git version.
QA_APP_DIR=..
# Use this when there is no git folder.
QA_APP_VERSION=
# Test logins only. Never a real person's login. Leave QA_USER empty when the app has no user names.
QA_USER=
QA_PASSWORD=
